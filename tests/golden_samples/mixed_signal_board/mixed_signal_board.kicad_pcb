(kicad_pcb (version 20240108) (generator pcbnew)
  (general (thickness 1.6))
  (net 0 "")
  (net 1 "GND")
  (net 2 "+3V3")
  (net 3 "SWCLK")
  (net 4 "SWDIO")
  (net 5 "USB_DP")
  (net 6 "USB_DM")
  (net 7 "PHY_TXD")

  (footprint "Package_QFP:LQFP-48" (layer "F.Cu") (at 50 50 0)
    (property "Reference" "U1")
    (property "Value" "STM32F401")
    (pad "1" smd rect (at -3.5 0) (size 0.3 1.2) (layers "F.Cu") (net 2 "+3V3") (pinfunction "VDD"))
    (pad "2" smd rect (at 3.5 0) (size 0.3 1.2) (layers "F.Cu") (net 1 "GND") (pinfunction "VSS"))
    (pad "3" smd rect (at 3.5 1) (size 0.3 1.2) (layers "F.Cu") (net 3 "SWCLK"))
    (pad "4" smd rect (at 3.5 2) (size 0.3 1.2) (layers "F.Cu") (net 4 "SWDIO"))
    (pad "5" smd rect (at 3.5 3) (size 0.3 1.2) (layers "F.Cu") (net 7 "PHY_TXD"))
  )

  (footprint "Connector:Conn_01x04" (layer "F.Cu") (at 48.0 50 0)
    (property "Reference" "CN1")
    (property "Value" "DebugHeader")
    (pad "1" smd rect (at 0 0) (size 0.6 0.5) (layers "F.Cu") (net 2 "+3V3"))
    (pad "2" smd rect (at 0 1) (size 0.6 0.5) (layers "F.Cu") (net 1 "GND"))
  )

  (footprint "Connector_USB:USB_C_Receptacle" (layer "F.Cu") (at 10 10 0)
    (property "Reference" "USB1")
    (property "Value" "USB-C")
    (pad "1" smd rect (at 0 0) (size 0.6 0.5) (layers "F.Cu") (net 5 "USB_DP"))
    (pad "2" smd rect (at 0 1) (size 0.6 0.5) (layers "F.Cu") (net 6 "USB_DM"))
  )

  (footprint "Package_TO_SOT_SMD:SOT-23" (layer "F.Cu") (at 20 80 0)
    (property "Reference" "U2")
    (property "Value" "DebugBuffer")
    (pad "1" smd rect (at 0 0) (size 0.6 0.4) (layers "F.Cu") (net 3 "SWCLK"))
    (pad "2" smd rect (at 0 1) (size 0.6 0.4) (layers "F.Cu") (net 4 "SWDIO"))
  )

  (footprint "Package_TO_SOT_SMD:SOT-23" (layer "F.Cu") (at 85 85 0)
    (property "Reference" "U3")
    (property "Value" "LevelShifter")
    (pad "1" smd rect (at 0 0) (size 0.6 0.4) (layers "F.Cu") (net 3 "SWCLK"))
    (pad "2" smd rect (at 0 1) (size 0.6 0.4) (layers "F.Cu") (net 7 "PHY_TXD"))
  )

  (segment (start 10 10) (end 45 10) (width 0.25) (layer "F.Cu") (net 5))
  (segment (start 10 11) (end 30 11) (width 0.25) (layer "F.Cu") (net 6))
  (segment (start 53.5 51) (end 20 80) (width 0.25) (layer "F.Cu") (net 3))
  (segment (start 20 80) (end 85 85) (width 0.25) (layer "F.Cu") (net 3))
  (segment (start 53.5 52) (end 20 81) (width 0.25) (layer "F.Cu") (net 4))
  (segment (start 53.5 53) (end 85 86) (width 0.25) (layer "F.Cu") (net 7))

  (zone (net 1) (net_name "GND") (layer "B.Cu")
    (polygon (pts (xy 0 0) (xy 100 0) (xy 100 100) (xy 0 100)))
  )
)
